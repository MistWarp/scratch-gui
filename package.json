{
  "name": "scratch-gui",
  "version": "3.2.37",
  "private": true,
  "description": "MistWarp editor, player, and community site",
  "author": "MistWarp contributors",
  "license": "GPL-3.0",
  "homepage": "https://mistwarp.org/",
  "repository": {
    "type": "git",
    "url": "https://github.com/MistWarp/scratch-gui.git"
  },
  "bugs": {
    "url": "https://github.com/MistWarp/scratch-gui/issues"
  },
  "main": "./dist/scratch-gui.js",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "start": "vite",
    "build": "node --max-old-space-size=7168 scripts/build.mjs --site-only",
    "build:all": "node --max-old-space-size=7168 scripts/build.mjs",
    "build:editor": "node scripts/build.mjs --entry=editor --no-community",
    "build:community": "node --max-old-space-size=7168 scripts/build.mjs --entry=community --community",
    "build:deploy": "node --max-old-space-size=7168 scripts/build.mjs --site-only --community",
    "build:stats": "node --max-old-space-size=7168 scripts/build.mjs --site-only --stats",
    "build:library": "node scripts/build.mjs --library",
    "build:report": "node scripts/build-report.mjs",
    "preview": "vite preview",
    "validate-deploy": "node scripts/validate-deploy.mjs build",
    "clean": "node -e \"for (const d of ['build', 'dist']) { fs.rmSync(d, {recursive: true, force: true}); fs.mkdirSync(d, {recursive: true}); }\"",
    "setup:microbit": "node scripts/microbit-hex.mjs",
    "check": "pnpm run lint && pnpm run i18n:editor:check && pnpm run i18n:community:check && pnpm run check:community-css && pnpm run test:unit:ci",
    "check:full": "pnpm run check && pnpm run deps:check && pnpm run build:deploy && pnpm run validate-deploy",
    "check:community-css": "node scripts/check-community-css.mjs",
    "lint": "eslint --ext .js,.jsx,.mjs,.cjs .",
    "fmt": "eslint --ext .js,.jsx,.mjs,.cjs --fix .",
    "hooks:install": "git config core.hooksPath .githooks",
    "test": "pnpm run check",
    "test:unit": "jest test[\\\\/]unit",
    "test:unit:ci": "jest --ci test[\\\\/]unit",
    "test:unit:watch": "jest test[\\\\/]unit --watch",
    "test:unit:addons": "jest test[\\\\/]unit[\\\\/]addons",
    "test:collab": "jest test[\\\\/]unit[\\\\/]collaboration",
    "test:integration": "node scripts/test-integration.mjs",
    "i18n:editor:extract": "node scripts/editor-default-messages.mjs",
    "i18n:editor:check": "node scripts/editor-default-messages.mjs --check",
    "i18n:community": "node scripts/community-translations.mjs",
    "i18n:community:add": "node scripts/community-translations.mjs add",
    "i18n:community:coverage": "node scripts/community-translations.mjs coverage",
    "i18n:community:extract": "node scripts/community-extract.mjs",
    "i18n:community:check": "node scripts/community-extract.mjs --check && node scripts/community-translations.mjs check",
    "deps:sync": "node scripts/sync-forks.mjs",
    "deps:check": "node scripts/sync-forks.mjs --check",
    "link": "node scripts/link-forks.mjs",
    "unlink": "node scripts/link-forks.mjs --unlink",
    "reinstall": "pnpm install --force && pnpm run link"
  },
  "dependencies": {
    "@fiahfy/icns": "0.0.7",
    "@isomorphic-git/lightning-fs": "^4.6.2",
    "@microbit/microbit-universal-hex": "0.2.2",
    "@turbowarp/json": "^0.1.2",
    "@turbowarp/jszip": "^3.11.1",
    "@turbowarp/nanolog": "^0.2.0",
    "@turbowarp/sbdl": "^4.0.1",
    "@turbowarp/scratch-l10n": "^3.1001.0-202401241456-994097a5",
    "@turbowarp/scratch-storage": "^0.0.202403251715",
    "@turbowarp/scratch-svg-renderer": "^1.0.0-202312242305-12c360b",
    "@turbowarp/startaudiocontext": "^1.0.0",
    "balance-text": "3.3.1",
    "bowser": "^2.12.1",
    "classnames": "2.2.6",
    "computed-style-to-inline-style": "3.0.0",
    "dapjs": "2.3.0",
    "fake-indexeddb": "^6.2.5",
    "fractch": "0.7.8",
    "get-user-media-promise": "1.1.4",
    "immutable": "3.8.2",
    "intl-messageformat": "^2.2.0",
    "isomorphic-git": "^1.34.0",
    "js-base64": "^3.7.8",
    "jsoneditor": "10.4.2",
    "keymirror": "0.1.1",
    "lodash.bindall": "4.4.0",
    "lodash.debounce": "4.0.8",
    "lodash.defaultsdeep": "4.6.1",
    "lodash.throttle": "4.0.1",
    "lucide-react": "^0.562.0",
    "omggif": "1.0.9",
    "papaparse": "5.3.0",
    "peerjs": "1.3.0",
    "prop-types": "^15.5.10",
    "react": "^16.0.0",
    "react-contextmenu": "2.9.4",
    "react-dom": "^16.0.0",
    "react-draggable": "3.0.5",
    "react-intl": "2.9.0",
    "react-modal": "3.9.1",
    "react-popover": "0.5.10",
    "react-redux": "5.0.7",
    "react-responsive": "5.0.0",
    "react-router-dom": "^6.30.4",
    "react-string-replace": "^0.4.4",
    "react-style-proptype": "3.2.2",
    "react-tabs": "2.3.0",
    "react-tooltip": "^5.29.1",
    "react-virtualized": "9.20.1",
    "redux": "3.7.2",
    "redux-throttle": "0.1.1",
    "rotur-sdk": "^2.0.0",
    "scratch-audio": "https://codeload.github.com/MistWarp/scratch-audio/tar.gz/2f2ad72ef9c5d11bbf2ca13560489cb5d33d4c33",
    "scratch-blocks": "https://codeload.github.com/MistWarp/scratch-blocks/tar.gz/34ab2cd34785353c25b9c16697bcba52a7c09dce",
    "scratch-paint": "https://codeload.github.com/MistWarp/scratch-paint/tar.gz/52db8c8ede05ab2f925148ec1e783ea39b9dfca0",
    "scratch-render": "https://codeload.github.com/MistWarp/scratch-render/tar.gz/ce8e30cb75fcba486d20a453bd51127f5a145a1a",
    "scratch-render-fonts": "https://codeload.github.com/PenguinMod/penguinmod-render-fonts/tar.gz/4dda62c707f64505266aa62f7a6cc84f0e5812fd",
    "scratch-vm": "https://codeload.github.com/MistWarp/scratch-vm/tar.gz/c775381a55c13029d15ae7fe87fdae24a6998cf9",
    "scratchblocks": "3.7.1",
    "sha.js": "^2.4.12",
    "to-style": "1.3.3",
    "wav-encoder": "1.3.0",
    "xhr": "2.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/parser": "^7.29.7",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-object-rest-spread": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-react": "^7.28.6",
    "@babel/traverse": "^7.29.7",
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.5",
    "babel-jest": "^29.7.0",
    "chromedriver": "^150.0.3",
    "ejs": "^6.0.1",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "1.15.7",
    "es-module-lexer": "^3.0.2",
    "eslint": "8.55.0",
    "eslint-config-scratch": "9.0.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "22.17.0",
    "eslint-plugin-react": "7.33.2",
    "intl-messageformat-parser": "1.8.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.28",
    "postcss-import": "^16.2.0",
    "postcss-simple-vars": "^7.0.1",
    "raf": "3.4.1",
    "react-test-renderer": "16.14.0",
    "redux-mock-store": "1.5.3",
    "selenium-webdriver": "3.6.0",
    "vite": "^6.4.3",
    "vite-plugin-node-polyfills": "^0.28.0",
    "web-audio-test-api": "0.5.2",
    "yauzl": "2.10.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "chromedriver",
      "esbuild",
      "fsevents",
      "scratch-blocks"
    ],
    "overrides": {
      "cheerio": "1.0.0-rc.12"
    },
    "patchedDependencies": {
      "@isomorphic-git/lightning-fs": "patches/@isomorphic-git__lightning-fs.patch",
      "scratch-parser": "patches/scratch-parser.patch",
      "@turbowarp/scratch-svg-renderer": "patches/@turbowarp__scratch-svg-renderer.patch",
      "rotur-sdk@2.5.2": "patches/rotur-sdk@2.5.2.patch"
    },
    "allowUnusedPatches": true
  },
  "module": "./dist/scratch-gui.mjs",
  "style": "./dist/scratch-gui.css",
  "engines": {
    "node": ">=20.19.0"
  }
}
