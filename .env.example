# Copy to .env for local development. Vite and scripts/build.mjs read .env; variables set
# in the shell take precedence. Everything except MW_COMMUNITY is commented out and shows
# its default.

# --- Pages ---------------------------------------------------------------

# "true" adds the community site and makes it the home page (the editor moves to /editor).
MW_COMMUNITY=true

# Build one page: editor, community, player, fullscreen, embed, addon-settings or credits.
# Prefer `pnpm run build:editor` / `build:community`, which pass --entry= to scripts/build.mjs.
# ONLY_ENTRY=

# --- Local server and output --------------------------------------------

# Port for `pnpm start` and `pnpm run preview`.
# PORT=8601

# Base URL of the site. Must end in "/".
# ROOT=/

# Output directory for site builds.
# BUILD_DIR=build

# "true" writes source maps.
# SOURCEMAP=

# Asset base path for the library build (`pnpm run build:library`).
# STATIC_PATH=/static

# Editor URL routing: wildcard (/123, /editor), hash (#123), filehash or none.
# ROUTING_STYLE=wildcard

# Extra <meta> tags for every page, as a JSON object of name to content.
# EXTRA_META={}

# Any non-empty value registers the service worker for offline use.
# ENABLE_SERVICE_WORKER=

# Any non-empty value outlines layout boxes in random colours, for debugging layout.
# DEBUG=

# --- Services --------------------------------------------------------------

# MistWarp API used by the community site, project embeds and Rotur thumbnails.
# Point it at a local API server to develop against it.
# MW_API_BASE=https://api.mistwarp.org/v1

# Realtime socket. Defaults to MW_API_BASE with http(s) replaced by ws(s), plus /ws.
# MW_API_WS=wss://api.mistwarp.org/v1/ws

# WarpTheme API used by the theme gallery.
# MW_WARPTHEME_API=https://warptheme.mistium.com/api

# Status service used by the community status page and analytics.
# MW_STATUS_URL=https://status.warp.mistium.com

# Google Fonts API key for the theme font picker. "demo" shows a built-in font list.
# GOOGLE_FONTS_API_KEY=demo

# --- Builds and deployment -------------------------------------------------

# Build identity written into the bundle and version.json. Defaults to GITHUB_SHA,
# then the checked-out commit, then "dev".
# MW_BUILD_ID=
# MW_BUILD_TIME=

# "true" writes stats.json and reports compressed sizes. Same as `pnpm run build:stats`.
# MW_BUILD_STATS=

# Any non-empty value clones and builds MistWarp/docs into /docs. A built sibling
# ../docs/build is copied in instead when it exists.
# MW_BUILD_DOCS=

# Directory of an already built docs site to copy into /docs.
# MW_DOCS_BUILD=

# Docs deployment that Cloudflare Pages builds download /docs from.
# MW_DOCS_ORIGIN=https://docs.warp.mistium.com

# On Cloudflare Pages, keep the fork pins from package.json instead of updating them.
# MW_PINNED_FORKS=

# --- Integration tests and install -----------------------------------------
# `pnpm run test:integration` and `pnpm install` read these from the shell, not from .env.

# "no" shows the Chrome window instead of running headless.
# USE_HEADLESS=yes

# Chrome binary and a chromedriver that matches it, when they are not the defaults.
# CHROME_BIN=
# CHROMEDRIVER_BIN=

# "true" skips the chromedriver download during `pnpm install` (CI sets it).
# CHROMEDRIVER_SKIP_DOWNLOAD=
